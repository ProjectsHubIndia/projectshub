# ==============================================================================
# ProjectsHub — Environment Variables (.env.example)
# Add these in Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================================

# Security
SECRET_KEY=django-insecure-generate-a-secure-random-key-for-production
DEBUG=False

# Allowed Hosts (comma-separated, .vercel.app is included by default)
ALLOWED_HOSTS=.vercel.app,projectshub.co.in,www.projectshub.co.in,127.0.0.1,localhost

# CSRF Trusted Origins (comma-separated, https://*.vercel.app is included by default)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://projectshub.co.in,https://www.projectshub.co.in

# Database (Optional: Recommended for persistent production data on Vercel)
# Free PostgreSQL from Neon (https://neon.tech) or Supabase (https://supabase.com)
# DATABASE_URL=postgres://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
