{
  "version": 2,
  "builds": [
    {
      "src": "projectshub/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/image/Favicon-new/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "projectshub/wsgi.py"
    }
  ]
}
